---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"
import Footer from "@/components/Footer.astro"
import { emailWorkPath, showEmailWork } from "@/data/email-templates"
import {
  defaultDescription,
  defaultTitle,
  hasResume,
  resumePath,
  siteName,
} from "@/data/site"

interface Props {
  title?: string
  socialTitle?: string
  description?: string
  image?: string
  ogType?: "website" | "article"
  noindex?: boolean
}

const {
  title = defaultTitle,
  socialTitle,
  description = defaultDescription,
  image = "/og.png",
  ogType = "website",
  noindex = false,
} = Astro.props

const canonicalURL = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  Astro.site ?? Astro.url.origin
)
const socialImageURL = image ? new URL(image, canonicalURL) : null

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"

const navLinks = [
  { label: "Home", href: "/", external: false },
  { label: "Projects", href: "/projects", external: false },
  ...(showEmailWork
    ? [{ label: "Email work", href: emailWorkPath, external: false }]
    : []),
  { label: "Contact", href: "/#contact", external: false },
  ...(hasResume
    ? [{ label: "Resume", href: resumePath, external: false }]
    : []),
]

function isActive(href: string) {
  if (href === "/") return pathname === "/"
  return !href.includes("#") && pathname.startsWith(href)
}
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#a8462a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={socialTitle ?? title} />
    <meta property="og:description" content={description} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta
      name="twitter:card"
      content={socialImageURL ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={socialTitle ?? title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only bg-background focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <div class="page-panel">
      <div class="pink-bar arial px-2 py-1 text-right text-xs font-bold">
        <a href="/" class="text-inherit! no-underline!">
          nm.works
        </a>
      </div>
      <header class="content-shell pt-4 text-center">
        <p>
          <a href="/" class="mx-auto block w-fit">
            <img
              src="/wordmark.svg"
              width="600"
              height="102"
              alt={siteName}
              class="mx-auto h-auto w-full max-w-[460px]"
            />
          </a>
        </p>
        <p class="mt-2 text-sm italic">
          email, print, and the web, from Raleigh, NC
        </p>
        <nav
          class="arial mt-3 text-[0.8125rem] leading-relaxed lowercase"
          aria-label="Main navigation"
        >
          [
          {navLinks.map((link, index) => (
            <>
              {index > 0 && " | "}
              <a
                href={link.href}
                {...(link.external
                  ? { target: "_blank", rel: "noreferrer" }
                  : {})}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[isActive(link.href) && "font-bold"]}
              >
                {link.label}
              </a>
            </>
          ))}
          ]
        </nav>
        <hr class="mt-4" />
      </header>
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
