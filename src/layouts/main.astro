---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"
import Footer from "@/components/Footer.astro"
import { emailWorkPath, showEmailWork } from "@/data/email-templates"
import {
  defaultDescription,
  defaultTitle,
  gitHubUrl,
  hasResume,
  linkedInUrl,
  resumePath,
  siteName,
} from "@/data/site"

interface Props {
  title?: string
  socialTitle?: string
  description?: string
  image?: string
  ogType?: "website" | "article"
  noindex?: boolean
}

const {
  title = defaultTitle,
  socialTitle,
  description = defaultDescription,
  image = "/og.png",
  ogType = "website",
  noindex = false,
} = Astro.props

const canonicalURL = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  Astro.site ?? Astro.url.origin
)
const socialImageURL = image ? new URL(image, canonicalURL) : null

const headerWidthClass = "max-w-3xl"

const navLinkClass =
  "-my-3 rounded-sm py-3 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:outline-none"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={socialTitle ?? title} />
    <meta property="og:description" content={description} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta
      name="twitter:card"
      content={socialImageURL ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={socialTitle ?? title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only bg-background text-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-sm focus:px-3 focus:py-2 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Skip to content
    </a>
    <header class="px-6 py-10 md:py-14">
      <nav
        class:list={[
          "mx-auto flex flex-col items-baseline gap-4 md:flex-row md:justify-between md:gap-6",
          headerWidthClass,
        ]}
        aria-label="Main navigation"
      >
        <a
          href="/"
          class="rounded-sm text-2xl font-bold transition-colors hover:text-muted-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:outline-none"
        >
          {siteName}
        </a>
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
          <a href="/projects" class={navLinkClass}>
            Projects
          </a>
          {showEmailWork && (
            <a href={emailWorkPath} class={navLinkClass}>
              Email work
            </a>
          )}
          <a href="/#contact" class={navLinkClass}>
            Contact
          </a>
          {hasResume && (
            <a href={resumePath} class={navLinkClass}>
              Resume
            </a>
          )}
          <a
            href={linkedInUrl}
            target="_blank"
            rel="noreferrer"
            class={navLinkClass}
          >
            LinkedIn
          </a>
          <a
            href={gitHubUrl}
            target="_blank"
            rel="noreferrer"
            class={navLinkClass}
          >
            GitHub
          </a>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
