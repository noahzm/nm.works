---
import Layout from "@/layouts/main.astro"
import CaseStudyHeader from "@/components/CaseStudyHeader.astro"
import CTA from "@/components/CTA.astro"
import { publishedProjects, type Project } from "@/data/projects"

interface Props {
  project: Project
  title?: string
  description?: string
  seoTitle?: string
  seoDescription?: string
}

const {
  project,
  title = project.title,
  description = project.description,
  seoTitle = `${project.title} · Noah Michaels`,
  seoDescription = project.description,
} = Astro.props

const currentProjectIndex = publishedProjects.findIndex(
  (p) => p.slug === project.slug
)
const hasNextProject = currentProjectIndex >= 0 && publishedProjects.length > 1
const next = hasNextProject
  ? publishedProjects[(currentProjectIndex + 1) % publishedProjects.length]
  : null
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={project.image?.src}
  ogType="article"
  noindex={project.status === "coming-soon"}
>
  <div class="content-shell pt-3 pb-6">
    <CaseStudyHeader
      project={project}
      title={title}
      description={description}
    />
    <article class="case-study">
      <slot />
    </article>

    <CTA />

    {next && (
      <p class="arial mt-4 text-right text-xs">
        Next project: <a href={`/projects/${next.slug}`}>{next.title}</a>{" "}
        &raquo;
      </p>
    )}
  </div>
</Layout>

<style is:global>
  .case-study {
    line-height: 1.5;
  }
  .case-study > * + * {
    margin-top: 1rem;
  }
  .case-study p,
  .case-study ul {
    max-width: 70ch;
  }
  .case-study h2 {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--stone);
    box-shadow: inset 0 1px 0 var(--bevel-highlight);
    font-size: 1rem;
    scroll-margin-top: 2rem;
  }
  .case-study h2:first-child {
    margin-top: 0;
  }
  .case-study h2 + p,
  .case-study h3 + p {
    margin-top: 0.5rem;
  }
  .case-study h3 {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }
  .case-study ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .case-study ul li + li {
    margin-top: 0.35rem;
  }
  .case-study figure {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .case-study figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    --feather: 22px;
  }
  .case-study figcaption {
    margin-top: 0.375rem;
    font-family: var(--font-arial);
    font-size: 0.75rem;
    font-style: italic;
    text-align: center;
    color: var(--heading);
  }
  /* Full-bleed figures that show the whole asset instead of a cropped fill. */
  .case-study .case-figure img {
    height: auto;
    object-fit: fill;
  }
</style>
