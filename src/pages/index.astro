---
import Layout from "@/layouts/main.astro"
import AsciiDivider from "@/components/AsciiDivider.astro"
import ProjectTable from "@/components/ProjectTable.astro"
import Contact from "@/components/Contact.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import { getProject } from "@/data/projects"
import {
  defaultDescription,
  defaultTitle,
  hasResume,
  resumePath,
  siteHeadline,
  siteName,
} from "@/data/site"

const selectedWork = [
  getProject("ncga-variable-data-stationery")!,
  getProject("creative-printing-order-flow")!,
  getProject("grouch")!,
  getProject("wheely-weather")!,
  getProject("print-split-calculator")!,
]
---

<Layout
  title={defaultTitle}
  socialTitle={`${siteName} · ${siteHeadline}`}
  description={defaultDescription}
>
  <div class="content-shell pt-3 pb-6">
    <h1 class="page-title">Hi, I’m Noah.</h1>

    <section aria-label="About">
      <p>
        I’ve spent the last 7+ years working across print production, brand
        identity, and the web: 4-color prepress, Pantone color systems,
        promotional merch and dielines, responsive email campaigns, and internal
        tools that make production run more smoothly. I work hands-on in
        InDesign, Illustrator, Photoshop, and HTML/CSS.
      </p>
      <p class="mt-3">
        <b>Lately:</b> designing multi-channel print and digital campaign
        assets, building responsive HTML email systems, and shipping Wheely
        Weather to the App Store.
      </p>
      <p class="mt-3">
        <b>School:</b> I studied Graphic Arts and Imaging Technology at
        Appalachian State (B.S., Cross-Media Production concentration, General
        Business minor).
      </p>
      <p class="mt-3">
        <a href="#contact">Say hi</a>
        {hasResume && (
          <>
            {" "}
            or{" "}
            <a href={resumePath} download>
              download my resume (PDF)
            </a>
          </>
        )}
        .
      </p>
    </section>

    <AsciiDivider class="my-5" />

    <section aria-labelledby="work-title">
      <SectionHeader titleId="work-title" title="Things I’ve Made" />
      <ProjectTable projects={selectedWork} caption="Things I’ve made" />
      <p class="arial mt-2 text-right text-xs">
        <a href="/projects">All projects &raquo;</a>
      </p>
    </section>

    <AsciiDivider class="my-5" />

    <Contact />

    <p class="arial mt-6 text-center text-xs">
      <a
        href="https://github.com/noahzm/nm.works"
        target="_blank"
        rel="noreferrer"
      >
        View this site’s source on GitHub
      </a>
    </p>
  </div>
</Layout>
