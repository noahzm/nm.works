---
import { Icon } from "astro-icon/components"
import Layout from "@/layouts/main.astro"
import ProjectPreview from "@/components/ProjectPreview.astro"
import CTA from "@/components/CTA.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import Separator from "@/components/ui/separator.astro"
import { getProject } from "@/data/projects"

const selectedWork = [
  getProject("wheely-weather")!,
  getProject("ncga-stationery-templates")!,
  getProject("creative-printing-order-flow")!,
]

const projectImpacts: Record<string, string> = {
  "ncga-stationery-templates":
    "Personalized mailings now run in one press pass instead of two, with no parallel files to drift.",
  "wheely-weather":
    "Shipped on iOS, Android, and web from one codebase, with the weakest weather signal driving the rating.",
  "creative-printing-order-flow":
    "Still the live homepage seven years later, with the category grid intact.",
}
---

<Layout>
  <div class="content-shell pt-4 pb-12 sm:pb-16">
    <section class="pb-10 md:pb-14" aria-label="About">
      <h1 class="max-w-3xl text-xl leading-relaxed text-foreground">
        I design software and printed matter.
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground">
        Interface design, information architecture, and internal tools on one
        side; stationery systems, separations, and press-ready files on the
        other. I write the front-end code too, so what ships looks and works the
        way it was designed.
      </p>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted-foreground">
        Right now that means a stationery template system for the North Carolina
        General Assembly print shop, where personalized mailings to all 170
        legislators run in one press pass instead of two, and Wheely Weather, a
        cycling weather app I designed and built for iOS, Android, and web.
      </p>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted-foreground">
        I’m based in Raleigh, NC, with a degree in Graphic Arts &amp; Imaging
        Technology from Appalachian State University.
      </p>
    </section>
    <Separator />

    <section class="py-12" aria-labelledby="work-title">
      <SectionHeader
        titleId="work-title"
        title="Selected work"
        description="Case studies across product UI, internal tools, and print production. All of it shipped."
      />

      <div class="mt-10 grid grid-cols-1 gap-y-14">
        {
          selectedWork.map((project, index) => (
            <a
              href={`/projects/${project.slug}`}
              aria-label={`View ${project.title}`}
              class="group block rounded-sm focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:outline-none"
            >
              <div class="mb-5 flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-bold group-hover:underline">
                    {project.title}
                  </h3>
                  <p class="mt-2 max-w-prose text-sm text-muted-foreground">
                    {project.teaser ?? project.summary}
                  </p>
                  <p class="mt-2 max-w-prose text-sm text-foreground">
                    <span class="font-bold">Outcome:</span>{" "}
                    {projectImpacts[project.slug]}
                  </p>
                </div>
                <span class="shrink-0 text-sm text-muted-foreground tabular-nums">
                  {project.year}
                </span>
              </div>
              <ProjectPreview
                project={project}
                widths={[600, 1000]}
                sizes="(min-width: 768px) 768px, 100vw"
                priority={index === 0}
              />
            </a>
          ))
        }
      </div>

      <div class="mt-12 flex flex-wrap items-baseline gap-x-6 gap-y-3">
        <a
          href="/projects"
          class="subtle-link inline-flex items-center gap-1 font-normal [&_svg]:size-3.5 [&_svg]:shrink-0"
        >
          All work
          <Icon
            name="lucide:arrow-right"
            aria-hidden="true"
            data-affix="inline-end"
          />
        </a>
        <a
          href="https://github.com/noahzm/nm.works"
          target="_blank"
          rel="noreferrer"
          class="subtle-link"
        >
          View this site’s source on GitHub
        </a>
      </div>
    </section>

    <CTA
      description="Open to UX, product, graphic design, and prepress roles. I’m at my best taking a rough idea all the way to a finished thing, whether that ships as software or comes off a press."
    />
  </div>
</Layout>
