---
import Layout from "@/layouts/main.astro"
import AsciiDivider from "@/components/AsciiDivider.astro"
import ProjectTable from "@/components/ProjectTable.astro"
import Contact from "@/components/Contact.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import { getProject } from "@/data/projects"
import {
  defaultDescription,
  defaultTitle,
  hasResume,
  resumePath,
  siteHeadline,
  siteName,
} from "@/data/site"

const selectedWork = [
  getProject("ncga-variable-data-stationery")!,
  getProject("print-split-calculator")!,
  getProject("creative-printing-order-flow")!,
  getProject("wheely-weather")!,
]

const highlights = [
  "Built a one-pass variable data workflow that merges base stationery with recipient-specific addresses and letter body content, for all 170 NC General Assembly members.",
  "Built an internal web tool that converts production data, like press speeds and job specs, into recommended machine splits.",
  "Built and maintained 20+ responsive client websites for Creative Printing in HTML/CSS, WordPress, and Drupal.",
  "Side project: Wheely Weather, an Expo app for iOS, Android, and web that turns live weather and air-quality data into rule-based ride recommendations.",
]
---

<Layout
  title={defaultTitle}
  socialTitle={`${siteName} · ${siteHeadline}`}
  description={defaultDescription}
>
  <div class="content-shell pt-3 pb-6">
    <h1 class="page-title">Email &amp; Marketing Automation</h1>

    <section aria-label="About">
      <p>
        I’ve spent 5+ years building data-driven print and digital output:
        variable data campaigns, responsive websites, and internal workflow
        tools. I work hands-on in HTML/CSS and WordPress/Drupal, with basic
        Python scripting. Based in Raleigh, NC.
      </p>
      <p class="mt-3">
        <b>In progress:</b> Salesforce Marketing Cloud Engagement Specialist
        certification, focused on email, segmentation, and journey automation.
      </p>
      <p class="mt-3">
        <a href="#contact">Get in touch</a>
        {hasResume && (
          <>
            {" "}
            or{" "}
            <a href={resumePath} download>
              download my resume (PDF)
            </a>
          </>
        )}
        .
      </p>
    </section>

    <AsciiDivider class="my-5" />

    <section aria-labelledby="work-title">
      <SectionHeader titleId="work-title" title="Selected Work" />
      <ProjectTable projects={selectedWork} caption="Selected work" />
      <p class="arial mt-2 text-right text-xs">
        <a href="/projects">All projects &raquo;</a>
      </p>
    </section>

    <AsciiDivider class="my-5" />

    <section aria-labelledby="highlights-title">
      <SectionHeader titleId="highlights-title" title="Highlights" />
      <ul class="list-disc space-y-2 pl-6">
        {highlights.map((text) => (
          <li>{text}</li>
        ))}
      </ul>
      <p class="mt-4">
        <b>Education:</b> B.S. in Graphic Arts and Imaging Technology, Cross
        Media Production concentration, General Business minor. Appalachian
        State University.
      </p>
    </section>

    <AsciiDivider class="my-5" />

    <Contact />

    <p class="arial mt-6 text-center text-xs">
      <a
        href="https://github.com/noahzm/nm.works"
        target="_blank"
        rel="noreferrer"
      >
        View this site’s source on GitHub
      </a>
    </p>
  </div>
</Layout>
