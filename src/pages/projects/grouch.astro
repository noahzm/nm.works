---
import CaseStudy from "@/layouts/case-study.astro"
import CaseStudyFigure from "@/components/CaseStudyFigure.astro"
import { getProject } from "@/data/projects"
import grouchWhiteImg from "@/assets/projects/grouch/grouchwhite.png"
import hatImg from "@/assets/projects/grouch/hat.jpg"
import setupImg from "@/assets/projects/grouch/setup.jpg"
import stickersImg from "@/assets/projects/grouch/stickers.jpg"

const project = getProject("grouch")!
---

<CaseStudy
  project={project}
  title="Grouch"
  seoDescription="An independent apparel and print goods line by Noah Michaels: original brand identity, spot-color screen printing separations, headwear, tote bags, and die-cut stickers."
>
  <p>
    Grouch was an independent apparel line I created with my roommate, Amari. I
    designed the brand identity—pairing a jagged custom Grouch wordmark with
    vintage public-domain character art—and Amari helped print garments and get
    the word out.
  </p>
  <p>
    I prepped film positives and burned the screens for two colorways: a
    single-color black print and a two-color run separating the black line work
    from the red-orange lettering. We pulled every garment by hand on a manual
    press, maintaining tight registration on the two-color shirts. Beyond tees,
    the line included custom-embroidered foam trucker hats, screen-printed tote
    bags, and die-cut vinyl stickers.
  </p>

  <CaseStudyFigure
    src={grouchWhiteImg}
    widths={[600, 1000]}
    sizes="(min-width: 768px) 768px, 100vw"
    imgClass="aspect-[4/3]"
    alt="White Grouch T-shirt printed in black only, with the jagged wordmark above three cartoon cats."
    caption="Single-color black print on white cotton tee."
  />

  <CaseStudyFigure
    src={setupImg}
    widths={[720, 1200]}
    sizes="(min-width: 768px) 768px, 100vw"
    imgClass="aspect-[3/2]"
    alt="Red screen-printing screen clamped above a platen, with the Grouch graphic burned into it in reverse."
    caption="Screen burned with emulsion, clamped on the press platen."
  />

  <div class="grid gap-x-6 sm:grid-cols-2">
    <CaseStudyFigure
      src={hatImg}
      widths={[480, 800]}
      sizes="(min-width: 768px) 380px, 100vw"
      imgClass="aspect-square"
      alt="Black foam trucker hat with an embroidered white-and-gold Grouch logo, a cartoon cat, and stars."
      caption="Trucker hat with direct embroidery."
    />
    <CaseStudyFigure
      src={stickersImg}
      widths={[480, 800]}
      sizes="(min-width: 768px) 380px, 100vw"
      imgClass="aspect-square"
      alt="A stack of die-cut Grouch stickers with orange lettering layered over the black wordmark."
      caption="Die-cut vinyl stickers with spot-color layering."
    />
  </div>
</CaseStudy>
