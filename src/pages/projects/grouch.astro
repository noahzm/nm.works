---
import { Picture } from "astro:assets"
import CaseStudy from "@/layouts/case-study.astro"
import AspectRatio from "@/components/ui/aspect-ratio.astro"
import { getProject } from "@/data/projects"
import grouchWhite from "@/assets/projects/grouch/grouchwhite.png"
import hat from "@/assets/projects/grouch/hat.jpg"
import setup from "@/assets/projects/grouch/setup.jpg"
import stickers from "@/assets/projects/grouch/stickers.jpg"

const project = getProject("grouch")!
const pictureFormats: ("avif" | "webp")[] = ["avif", "webp"]
---

<CaseStudy
  project={project}
  title="Grouch"
  seoTitle="Grouch · Brand and Apparel Work"
  seoDescription="Grouch was a limited-run brand and apparel project by Noah Michaels, spanning identity, T-shirts, hats, totes, stickers, and hands-on production."
>
  <h2>Overview</h2>
  <p>
    Grouch was an independent apparel and brand identity project featuring a
    custom rough-edged wordmark over a reworked public-domain cartoon
    illustration. The branding was produced across hand-pulled screen-printed
    T-shirts, embroidered snapback hats, tote bags, and die-cut stickers.
  </p>

  <h2>Brand &amp; Artwork</h2>
  <p>
    I processed the source illustration into a high-contrast graphic with a DIY
    skate-flyer character. That bold texture ensured clean color separation on
    the press, which fine-line artwork wouldn’t have held. The design was
    printed in two distinct colorways: a single-color black edition and a
    two-color version with a vibrant red-orange accent on the wordmark.
  </p>

  <figure>
    <AspectRatio ratio={4 / 3}>
      <Picture
        src={grouchWhite}
        formats={pictureFormats}
        widths={[600, 1000]}
        sizes="(min-width: 768px) 768px, 100vw"
        alt="White Grouch T-shirt printed in black only, with the wordmark above a cartoon-cat graphic."
      />
    </AspectRatio>
    <figcaption>
      The black-only colorway, printed from the same artwork as the two-color
      version.
    </figcaption>
  </figure>

  <h2>Production</h2>
  <p>
    Shirts were screen printed by hand; hats and stickers were produced offsite.
  </p>

  <div class="grid gap-8 sm:grid-cols-2">
    <figure>
      <AspectRatio ratio={4 / 3}>
        <Picture
          src={hat}
          formats={pictureFormats}
          widths={[480, 800]}
          sizes="(min-width: 768px) 360px, 100vw"
          alt="Black Grouch snapback hat with an embroidered orange logo."
        />
      </AspectRatio>
      <figcaption>Snapback hat with embroidered Grouch logo.</figcaption>
    </figure>
    <figure>
      <AspectRatio ratio={4 / 3}>
        <Picture
          src={stickers}
          formats={pictureFormats}
          widths={[480, 800]}
          sizes="(min-width: 768px) 360px, 100vw"
          alt="Die-cut Grouch stickers arranged on a tabletop."
        />
      </AspectRatio>
      <figcaption>Die-cut stickers carried the mark beyond apparel.</figcaption>
    </figure>
  </div>

  <figure>
    <AspectRatio ratio={4 / 3}>
      <Picture
        src={setup}
        formats={pictureFormats}
        widths={[720, 1200]}
        sizes="(min-width: 768px) 768px, 100vw"
        alt="Screen-printing press with the Grouch graphic inked on the screen, mid-print."
      />
    </AspectRatio>
    <figcaption>
      Every shirt was pulled by hand on a single-station press.
    </figcaption>
  </figure>
</CaseStudy>
