---
import { Picture } from "astro:assets"
import CaseStudy from "@/layouts/case-study.astro"
import { getProject } from "@/data/projects"
import homepageImg from "@/assets/projects/creative-printing/creative-printing.png"

const project = getProject("creative-printing-order-flow")!

const pictureFormats: ("avif" | "webp")[] = ["avif", "webp"]
const pictureWidths = [640, 960, 1280]
const pictureSizes = "(min-width: 768px) 960px, 100vw"
---

<CaseStudy
  project={project}
  title="Creative Printing Order Flow"
  seoTitle="Creative Printing Order Flow · UX Redesign"
  seoDescription="Redesigning Creative Printing’s homepage order path with responsive icon-grid navigation, clearer information architecture, and direct routes into service intake."
>
  <h2>Overview</h2>
  <p>
    Creative Printing needed a homepage that helped customers immediately start
    the right type of order, whether requesting copies, business cards,
    envelopes, wide-format signs, multimedia conversions, or website services.
    Each service category requires distinct intake questions and workflows, so a
    single generic form was impractical.
  </p>

  <h2>The Category Grid</h2>
  <p>
    I restructured the homepage around the primary ordering moment. The main
    service categories sit in a prominent icon grid, labeled with terms
    customers naturally use rather than internal shop jargon. Each tile routes
    directly to the relevant service page or intake form, making the order path
    clear and immediate.
  </p>

  <div class="order-flow" aria-label="Creative Printing order flow">
    <div class="order-flow__node">
      <span>Homepage</span>
      <strong>Order Now</strong>
    </div>
    <div class="order-flow__connector" aria-hidden="true"></div>
    <div class="order-flow__node order-flow__node--wide">
      <span>Category grid</span>
      <strong>Recognize the job type</strong>
    </div>
    <div class="order-flow__connector" aria-hidden="true"></div>
    <div class="order-flow__node">
      <span>Next step</span>
      <strong>Service page or intake form</strong>
    </div>
  </div>

  <figure class="case-figure">
    <Picture
      src={homepageImg}
      alt="Full Creative Printing homepage: logo and phone number, main navigation, an illustrated storefront hero with an Order Now button, the eight-tile order grid, and a location map."
      formats={pictureFormats}
      widths={pictureWidths}
      sizes={pictureSizes}
    />
    <figcaption>
      The complete homepage layout. A single call-to-action button in the hero
      leads directly to the eight-tile service grid, making order selection the
      focal point of the page.
    </figcaption>
  </figure>

  <h2>Outcome</h2>
  <p>
    The shop owner reviewed and approved the grid layout before launch. Seven
    years later, the category grid still anchors the live site.
  </p>
</CaseStudy>

<style>
  .order-flow {
    display: grid;
    gap: 0.75rem;
    margin: 1.75rem 0;
  }

  .order-flow__node {
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 1rem;
    background: color-mix(in oklch, var(--background) 96%, var(--muted));
  }

  .order-flow__node span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .order-flow__node strong {
    display: block;
    font-size: 0.9375rem;
  }

  .order-flow__connector {
    width: 1px;
    height: 1.25rem;
    margin-left: 1.25rem;
    background: var(--border);
  }

  @media (min-width: 640px) {
    .order-flow {
      grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 1.2fr) 2rem minmax(
          0,
          1fr
        );
      align-items: center;
      gap: 0;
    }

    .order-flow__connector {
      width: 100%;
      height: 1px;
      margin-left: 0;
    }
  }
</style>
