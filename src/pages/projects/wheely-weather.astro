---
import { Picture } from "astro:assets"
import CaseStudy from "@/layouts/case-study.astro"
import { getProject } from "@/data/projects"
import hourlyKitNumbersImg from "@/assets/projects/wheely-weather/hourly-kit-numbers.png"

const project = getProject("wheely-weather")!
const pictureFormats: ("avif" | "webp")[] = ["avif", "webp"]
const pictureWidths = [640, 960, 1280]
const pictureSizes = "(min-width: 768px) 960px, 100vw"
---

<CaseStudy
  project={project}
  title="Wheely Weather"
  seoDescription="Wheely Weather is a side project: an Expo app for iOS, Android, and web that turns live weather and air-quality data into rule-based ride verdicts, hourly riding windows, and kit guidance."
>
  <h2>Overview</h2>
  <p>
    Wheely Weather answers one core question before a ride: <em
      >should I ride right now?</em
    > Conversations with recreational and commuter cyclists highlighted three weather
    signals that mattered most: dew point, feels-like temperature, and wind speed.
    Among these, dew point was the most critical indicator riders missed in standard
    weather apps.
  </p>

  <h2 id="how-it-works">How It Works</h2>
  <p>
    The screen follows the order of a rider’s questions: can I go, why did it
    get that rating, and what should I wear?
  </p>
  <ul>
    <li>
      <strong>Verdict:</strong> a rule-based rating from Ideal to Don’t Ride, scored
      by the weakest signal, that names the limiting factor whenever conditions drop.
    </li>
    <li>
      <strong>Signals:</strong> temperature, dew point, and wind, plus precipitation,
      air quality, UV index, and sunset timing.
    </li>
    <li>
      <strong>Riding window:</strong> when conditions are poor, the hourly forecast
      highlights the next favorable window.
    </li>
    <li>
      <strong>Kit:</strong> the same data powers personalized kit suggestions.
    </li>
  </ul>
  <p>Raw weather numbers stay visible for riders who want the details.</p>

  <figure>
    <Picture
      src={hourlyKitNumbersImg}
      formats={pictureFormats}
      widths={pictureWidths}
      sizes={pictureSizes}
      alt="Wheely Weather hour-by-hour ride-quality chart with a POOR sticker, Today’s kit guidance, and The numbers cards showing raw weather signals."
    />
    <figcaption>
      The hour-by-hour chart reads as a window, not a forecast: ride quality by
      hour, a Now marker, and kit guidance below.
    </figcaption>
  </figure>

  <h2>Built With</h2>
  <p>
    One Expo Router and React Native codebase covers iOS, Android, and web. The
    ride-scoring rules live in a single shared TypeScript module, so every
    platform scores conditions the same way.
  </p>
  <ul>
    <li>
      <strong>Web:</strong> live on Cloudflare Workers at <a
        href="https://wheelyweather.app"
        target="_blank"
        rel="noreferrer">wheelyweather.app</a
      >.
    </li>
    <li>
      <strong>Data:</strong> Open-Meteo by default, with Apple WeatherKit on iOS through
      a small Swift native module (my Swift is basic).
    </li>
    <li>
      <strong>Quality:</strong> strict TypeScript, Vitest unit tests, Playwright end-to-end
      tests, and GitHub Actions CI.
    </li>
  </ul>
</CaseStudy>
