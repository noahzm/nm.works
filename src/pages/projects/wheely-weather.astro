---
import { Picture } from "astro:assets"
import CaseStudy from "@/layouts/case-study.astro"
import { getProject } from "@/data/projects"
import hourlyKitNumbersImg from "@/assets/projects/wheely-weather/hourly-kit-numbers.png"

const project = getProject("wheely-weather")!
const pictureFormats: ("avif" | "webp")[] = ["avif", "webp"]
const pictureWidths = [640, 960, 1280]
const pictureSizes = "(min-width: 768px) 960px, 100vw"
---

<CaseStudy
  project={project}
  title="Wheely Weather"
  seoTitle="Wheely Weather · Cross-Platform Cycling Weather App (Expo)"
  seoDescription="Wheely Weather is a cross-platform cycling weather app built with Expo for iOS, Android, and web, with ride-quality verdicts, hourly riding windows, and weather-based kit guidance."
>
  <h2>Overview</h2>
  <p>
    Wheely Weather answers one question before a ride: <em
      >is it worth going now?</em
    > Six conversations with recreational and commuter cyclists pointed to the same
    three signals, dew point, feels-like temperature, and wind, with dew point the
    easiest to miss in the apps they already used.
  </p>

  <h2>How It Works</h2>
  <p>
    The weakest signal sets a five-level rating, and the app names the limiting
    condition when the rating drops. Raw numbers stay visible for riders who
    disagree with it. When the answer is no, the hour-by-hour view points to the
    next usable window, and the same data drives kit guidance.
  </p>

  <figure>
    <Picture
      src={hourlyKitNumbersImg}
      formats={pictureFormats}
      widths={pictureWidths}
      sizes={pictureSizes}
      alt="Wheely Weather hour-by-hour ride-quality chart with a POOR sticker, Today’s kit guidance, and The numbers cards showing raw weather signals."
    />
    <figcaption>
      The hour-by-hour chart reads as a window, not a forecast: ride quality by
      hour, a Now marker, and kit guidance below.
    </figcaption>
  </figure>

  <h2 id="system-design">System Design</h2>
  <p>
    Screen order follows the rider’s question sequence rather than the shape of
    a forecast API: can I go, why that rating, what should I wear? A shared
    TypeScript scoring domain in <code>src/domain/</code> feeds every platform, and
    theme-aware components render the same tree on iOS, Android, and web.
  </p>

  <h2>Built With</h2>
  <p>
    One Expo Router and React Native codebase for iOS, Android, and web, live on
    Cloudflare Workers at <a
      href="https://wheelyweather.app"
      target="_blank"
      rel="noreferrer">wheelyweather.app</a
    >. Open-Meteo by default, Apple WeatherKit on iOS through a custom native
    module. Strict TypeScript, Vitest, Playwright, and GitHub Actions CI.
  </p>
</CaseStudy>
