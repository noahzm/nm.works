---
import Layout from "@/layouts/main.astro"
import ProjectTable from "@/components/ProjectTable.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import CTA from "@/components/CTA.astro"
import { publishedProjects, upcomingCaseStudies } from "@/data/projects"
---

<Layout
  title="Projects · Noah Michaels"
  description="Projects and case studies by Noah Michaels: print production, typography and layout, brand identity, screen printing, web systems, and product design."
>
  <div class="content-shell pt-3 pb-6">
    <h1 class="page-title">Projects</h1>

    <section aria-labelledby="selected-work-title">
      <SectionHeader
        titleId="selected-work-title"
        title="Case Studies & Side Projects"
      />
      <ProjectTable
        projects={publishedProjects}
        caption="Case studies and side projects"
      />
    </section>

    {upcomingCaseStudies.length > 0 && (
      <section class="mt-6" aria-labelledby="upcoming-title">
        <SectionHeader titleId="upcoming-title" title="In Progress" />
        <ProjectTable projects={upcomingCaseStudies} caption="In progress" />
      </section>
    )}

    <CTA />
  </div>
</Layout>
