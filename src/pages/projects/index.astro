---
import Layout from "@/layouts/main.astro"
import ProjectTable from "@/components/ProjectTable.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import CTA from "@/components/CTA.astro"
import {
  publishedCaseStudies,
  upcomingCaseStudies,
  sideProjects,
} from "@/data/projects"
---

<Layout
  title="Projects · Noah Michaels"
  description="Case studies by Noah Michaels: variable data personalization, production QA, responsive web builds, and side projects."
>
  <div class="content-shell pt-3 pb-6">
    <h1 class="page-title">Projects</h1>

    <section aria-labelledby="case-studies-title">
      <SectionHeader titleId="case-studies-title" title="Case Studies" />
      <ProjectTable projects={publishedCaseStudies} caption="Case studies" />
    </section>

    {upcomingCaseStudies.length > 0 && (
      <section class="mt-6" aria-labelledby="upcoming-title">
        <SectionHeader titleId="upcoming-title" title="In Progress" />
        <ProjectTable projects={upcomingCaseStudies} caption="In progress" />
      </section>
    )}

    <section class="mt-6" aria-labelledby="side-projects-title">
      <SectionHeader titleId="side-projects-title" title="Side Projects" />
      <ProjectTable projects={sideProjects} caption="Side projects" />
    </section>

    <CTA />
  </div>
</Layout>
