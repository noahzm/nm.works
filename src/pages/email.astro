---
import { Picture } from "astro:assets"
import CTA from "@/components/CTA.astro"
import Layout from "@/layouts/main.astro"
import { emailTemplates, showEmailWork } from "@/data/email-templates"
import { siteName } from "@/data/site"
---

<Layout
  title={`Email work · ${siteName}`}
  description="HTML email templates by Noah Michaels: responsive layouts, personalization, and the techniques behind each build."
  noindex={!showEmailWork}
>
  <div class="content-shell pt-3 pb-6">
    <header class="pb-4">
      <h1 class="page-title">Email Work</h1>
      <p>
        HTML email templates, each with a live preview or screenshot and the
        techniques used to build it.
      </p>
    </header>

    {emailTemplates.length === 0 ? (
      <p class="arial text-sm italic">Templates are on the way.</p>
    ) : (
      <div>
        {emailTemplates.map((template) => (
          <article
            class="border-t border-[var(--stone)] py-6 first:border-t-0 first:pt-0"
            aria-labelledby={`email-${template.slug}`}
          >
            <h2 id={`email-${template.slug}`} class="section-title">
              {template.title}
            </h2>
            <p class="mt-2">{template.description}</p>
            {template.techniques.length > 0 && (
              <p class="arial mt-2 text-xs italic">
                Techniques: {template.techniques.join(", ")}
              </p>
            )}
            {template.previewHtml ? (
              <div class="mt-6">
                <iframe
                  src={template.previewHtml}
                  title={`Live preview of ${template.title}`}
                  sandbox=""
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  class="h-[40rem] w-full border-2 border-[var(--stone-light)] bg-white [border-style:inset]"
                ></iframe>
                <p class="arial mt-1 text-right text-xs">
                  <a
                    href={template.previewHtml}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Open full preview &raquo;
                  </a>
                </p>
              </div>
            ) : (
              template.screenshot &&
              template.screenshotAlt && (
                <figure class="mt-6">
                  <Picture
                    src={template.screenshot}
                    formats={["avif", "webp"]}
                    widths={[600, 1000]}
                    sizes="(min-width: 768px) 768px, 100vw"
                    alt={template.screenshotAlt}
                    class="feather w-full"
                  />
                </figure>
              )
            )}
          </article>
        ))}
      </div>
    )}

    <CTA />
  </div>
</Layout>
