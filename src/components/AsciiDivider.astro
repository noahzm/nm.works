---
// Pine-and-dogwood rule, used in place of a plain <hr> between sections.
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<p class:list={["ascii-divider", className]} aria-hidden="true">
  {"^ ~ ^^ ~~ ^ ~~~ ^^^ ~~ "}
  <span class="dogwood">(@)</span>
  {" ~~ ^^^ ~~~ ^ ~~ ^^ ~ ^"}
</p>

<style>
  .ascii-divider {
    overflow: hidden;
    font-family: "Courier New", Courier, monospace;
    font-size: 0.8125rem;
    text-align: center;
    white-space: pre;
    color: var(--heading);
  }
  .dogwood {
    color: var(--bar);
    font-weight: 700;
  }
</style>
