---
// Pine-and-dogwood rule, used in place of a plain <hr> between sections.
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<p class:list={["ascii-divider", className]} aria-hidden="true">
  <span class="ascii-divider-line">
    {"^ ~ ^^ ~~ ^ ~~~ ^^^ ~~ "}
    <span class="dogwood">(@)</span>
    {" ~~ ^^^ ~~~ ^ ~~ ^^ ~ ^"}
  </span>
</p>

<style>
  .ascii-divider {
    overflow: hidden;
    font-family: "Courier New", Courier, monospace;
    font-size: 0.8125rem;
    text-align: center;
    white-space: pre;
    color: var(--heading);
    container-type: inline-size;
  }
  /* The rule is 49 monospace chars (~29.4em); shrink it to fit narrow screens. */
  .ascii-divider-line {
    font-size: min(0.8125rem, 100cqi / 30);
  }
  .dogwood {
    color: var(--bar);
    font-weight: 700;
  }
</style>
