---
import { Picture } from "astro:assets"
import {
  disciplineLabels,
  type Project,
  type ProjectHeaderLink,
} from "@/data/projects"

interface Props {
  project: Project
  title?: string
  description?: string
}

interface MetadataItem {
  label: string
  value: string
  fullWidth?: boolean
}

const {
  project,
  title = project.title,
  description = project.description,
} = Astro.props

const metadataItems: MetadataItem[] = [
  { label: "Role", value: project.role },
  { label: "Year", value: project.year },
  ...(project.status === "coming-soon"
    ? [{ label: "Status", value: "In progress" }]
    : []),
  ...(project.headerDetails?.map((item, _, items) => ({
    ...item,
    fullWidth: items.length === 1,
  })) ?? []),
]

const hasHeaderLinks =
  project.appStoreUrl ||
  project.liveUrl ||
  project.githubUrl ||
  (project.headerLinks && project.headerLinks.length > 0)

function isExternalLink(link: ProjectHeaderLink) {
  return link.external !== false && !link.href.startsWith("#")
}
---

<header class="mb-6">
  <p class="arial text-xs">
    <a href="/projects">&laquo; Back to projects</a>
  </p>
  <h1 class="page-title">{title}</h1>
  <p>{description}</p>
  <table class="old-table mt-4">
    <caption class="sr-only">Project details</caption>
    <tbody>
      {metadataItems.map((item) => (
        <tr>
          <th scope="row">{item.label}</th>
          <td>{item.value}</td>
        </tr>
      ))}
      <tr>
        <th scope="row">Disciplines</th>
        <td>
          {project.disciplines.map((d) => disciplineLabels[d]).join(", ")}
        </td>
      </tr>
      {project.whatICanShow && (
        <tr>
          <th scope="row">What I can show</th>
          <td>{project.whatICanShow}</td>
        </tr>
      )}
      {hasHeaderLinks && (
        <tr>
          <th scope="row">Links</th>
          <td>
            {[
              project.appStoreUrl && {
                label: "Download on the App Store",
                href: project.appStoreUrl,
                external: true,
              },
              project.liveUrl && {
                label: project.liveUrlLabel ?? "View web app",
                href: project.liveUrl,
                external: true,
              },
              project.githubUrl && {
                label: "View on GitHub",
                href: project.githubUrl,
                external: true,
              },
              ...(project.headerLinks?.map((link) => ({
                label: link.label,
                href: link.href,
                external: isExternalLink(link),
              })) ?? []),
            ]
              .filter((link) => !!link)
              .map((link, index) => (
                <>
                  {index > 0 && " | "}
                  <a
                    href={link.href}
                    {...(link.external
                      ? { target: "_blank", rel: "noreferrer" }
                      : {})}
                  >
                    {link.label}
                  </a>
                </>
              ))}
          </td>
        </tr>
      )}
    </tbody>
  </table>
  {project.image && project.imageAlt && (
    <figure class="mt-5">
      <Picture
        src={project.image}
        formats={["avif", "webp"]}
        widths={[720, 1200, 1600]}
        sizes="(min-width: 850px) 810px, 100vw"
        alt={project.imageAlt}
        loading="eager"
        fetchpriority="high"
        style={
          project.imageObjectPosition
            ? `object-position: ${project.imageObjectPosition}`
            : undefined
        }
        class="feather aspect-[3/2] w-full object-cover [--feather:24px]"
      />
    </figure>
  )}
</header>
