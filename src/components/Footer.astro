---
import Separator from "@/components/ui/separator.astro"
import { emailWorkPath, showEmailWork } from "@/data/email-templates"
import {
  contactEmail,
  contactHref,
  gitHubUrl,
  hasResume,
  linkedInUrl,
  resumePath,
  siteName,
} from "@/data/site"

const year = new Date().getFullYear()

const links = [
  { label: "Projects", href: "/projects", external: false },
  ...(showEmailWork
    ? [{ label: "Email work", href: emailWorkPath, external: false }]
    : []),
  { label: contactEmail, href: contactHref, external: false },
  ...(hasResume
    ? [{ label: "Resume (PDF)", href: resumePath, external: false }]
    : []),
  { label: "LinkedIn", href: linkedInUrl, external: true },
  { label: "GitHub", href: gitHubUrl, external: true },
]
---

<footer class="content-shell pb-14">
  <Separator />
  <div
    class="flex flex-col gap-4 pt-8 sm:flex-row sm:items-baseline sm:justify-between"
  >
    <p class="text-sm text-muted-foreground">
      {siteName}. Raleigh, NC. &copy;{" "}{year}
    </p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
      {
        links.map((link) => (
          <a
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}
            class="subtle-link"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
