---
import { emailWorkPath, showEmailWork } from "@/data/email-templates"
import {
  contactEmail,
  contactHref,
  gitHubUrl,
  hasResume,
  linkedInUrl,
  resumePath,
  siteName,
} from "@/data/site"

const year = new Date().getFullYear()

const links = [
  { label: "Projects", href: "/projects", external: false },
  ...(showEmailWork
    ? [{ label: "Email work", href: emailWorkPath, external: false }]
    : []),
  { label: contactEmail, href: contactHref, external: false },
  ...(hasResume
    ? [{ label: "Resume (PDF)", href: resumePath, external: false }]
    : []),
  { label: "LinkedIn", href: linkedInUrl, external: true },
  { label: "GitHub", href: gitHubUrl, external: true },
]
---

<footer class="content-shell arial pt-2 pb-5 text-center text-xs lowercase">
  <hr class="mb-3" />
  <nav aria-label="Footer">
    {links.map((link, index) => (
      <>
        {index > 0 && " | "}
        <a
          href={link.href}
          {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}
        >
          {link.label}
        </a>
      </>
    ))}
  </nav>
  <p class="mt-3">
    <a href="/" class="inline-block">
      <img
        src="/badges/nm-works-88x31.gif"
        width="88"
        height="31"
        alt="nm.works specimen plate badge"
        class="[image-rendering:pixelated]"
      />
    </a>
  </p>
  <p class="mt-2 text-[var(--heading)]">
    &copy; {year} {siteName}. Raleigh, NC.
  </p>
</footer>
