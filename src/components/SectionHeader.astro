---
interface Props {
  eyebrow?: string
  title: string
  titleId?: string
  description?: string
}

const { eyebrow, title, titleId, description } = Astro.props
---

<header class="mb-3">
  {eyebrow && <p class="arial mb-1 text-xs italic">{eyebrow}</p>}
  <h2 id={titleId} class="section-title mb-0!">
    {title}
  </h2>
  {description && <p class="mt-2">{description}</p>}
</header>
