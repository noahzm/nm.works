---
import {
  contactEmail,
  contactHref,
  gitHubUrl,
  hasResume,
  linkedInUrl,
  resumePath,
} from "@/data/site"
---

<section id="contact" class="scroll-mt-8" aria-labelledby="contact-title">
  <h2 id="contact-title" class="section-title">
    Contact
  </h2>
  <p>
    Open to email marketing, marketing automation, and production roles. Email
    is the fastest way to reach me.
  </p>
  <table class="old-table mt-3 max-w-md">
    <tbody>
      <tr>
        <th scope="row">Email</th>
        <td>
          <a href={contactHref}>{contactEmail}</a>
        </td>
      </tr>
      {hasResume && (
        <tr>
          <th scope="row">Resume</th>
          <td>
            <a href={resumePath} download>
              Download (PDF)
            </a>
          </td>
        </tr>
      )}
      <tr>
        <th scope="row">LinkedIn</th>
        <td>
          <a href={linkedInUrl} target="_blank" rel="noreferrer">
            linkedin.com/in/noahzm
          </a>
        </td>
      </tr>
      <tr>
        <th scope="row">GitHub</th>
        <td>
          <a href={gitHubUrl} target="_blank" rel="noreferrer">
            github.com/noahzm
          </a>
        </td>
      </tr>
    </tbody>
  </table>
</section>
