---
import { Icon } from "astro-icon/components"
import ExternalArrow from "@/components/ExternalArrow.astro"
import { buttonVariants } from "@/components/ui/button-variants"
import Separator from "@/components/ui/separator.astro"
import {
  contactEmail,
  contactHref,
  gitHubUrl,
  hasResume,
  linkedInUrl,
  resumePath,
} from "@/data/site"
---

<section id="contact" class="scroll-mt-8 py-12" aria-labelledby="contact-title">
  <Separator />
  <div class="pt-12">
    <h2 id="contact-title" class="section-title">
      Contact
    </h2>
    <p class="mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
      Open to email marketing, marketing automation, and production roles. Email
      is the fastest way to reach me.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a
        href={contactHref}
        data-slot="button"
        data-variant="default"
        data-size="default"
        class={buttonVariants({ variant: "default" })}
      >
        <Icon name="lucide:mail" aria-hidden="true" data-affix="inline-start" />
        {contactEmail}
      </a>
      {hasResume && (
        <a
          href={resumePath}
          download
          data-slot="button"
          data-variant="outline"
          data-size="default"
          class={buttonVariants({ variant: "outline" })}
        >
          <Icon
            name="lucide:download"
            aria-hidden="true"
            data-affix="inline-start"
          />
          Resume (PDF)
        </a>
      )}
    </div>
    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2" aria-label="Elsewhere">
      <li>
        <a
          href={linkedInUrl}
          target="_blank"
          rel="noreferrer"
          class="subtle-link inline-flex items-center gap-1 [&_svg]:size-3.5"
        >
          LinkedIn
          <ExternalArrow />
        </a>
      </li>
      <li>
        <a
          href={gitHubUrl}
          target="_blank"
          rel="noreferrer"
          class="subtle-link inline-flex items-center gap-1 [&_svg]:size-3.5"
        >
          GitHub
          <ExternalArrow />
        </a>
      </li>
    </ul>
  </div>
</section>
