---
import { contactHref } from "@/data/site"

interface Props {
  title?: string
  description?: string
  href?: string
  label?: string
}

const {
  title = "Let’s build something useful.",
  description = "Open to email marketing, marketing automation, and production roles.",
  href = contactHref,
  label = "Get in touch",
} = Astro.props
---

<section class="mt-8">
  <hr class="mb-4" />
  <p class="text-center">
    <b>{title}</b>
    {description && <> {description}</>}
    <br />
    <a href={href}>{label} &raquo;</a>
  </p>
</section>
