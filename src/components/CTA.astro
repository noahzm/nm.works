---
import { contactHref } from "@/data/site"

interface Props {
  title?: string
  description?: string
  href?: string
  label?: string
}

const {
  title,
  description = "I’m open to email marketing, marketing automation, and production roles.",
  href = contactHref,
  label = "Say hi",
} = Astro.props
---

<section class="mt-8">
  <hr class="mb-4" />
  <p class="text-center">
    {title && <b>{title} </b>}
    {description}
    <br />
    <a href={href}>{label} &raquo;</a>
  </p>
</section>
