---
import type { ImageMetadata } from "astro"
import { Picture } from "astro:assets"

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  class?: string
  imgClass?: string
  widths?: number[]
  sizes?: string
  formats?: ("avif" | "webp" | "png" | "jpg")[]
  variant?: "cover" | "contain"
  loading?: "lazy" | "eager"
}

const {
  src,
  alt,
  caption,
  class: className = "",
  imgClass = "",
  widths = [640, 960, 1280],
  sizes = "(min-width: 768px) 960px, 100vw",
  formats = ["avif", "webp"],
  variant = "cover",
  loading = "lazy",
} = Astro.props

const figureClasses = [variant === "contain" && "case-figure", className]
  .filter(Boolean)
  .join(" ")
---

<figure class={figureClasses || undefined}>
  <Picture
    src={src}
    alt={alt}
    formats={formats}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class={imgClass || undefined}
  />
  {(caption || Astro.slots.has("default")) && (
    <figcaption>
      {caption}
      <slot />
    </figcaption>
  )}
</figure>
