---
import { Picture } from "astro:assets"
import type { Project } from "@/data/projects"

interface Props {
  project: Project
  widths?: number[]
  sizes?: string
  class?: string
  priority?: boolean
}

const {
  project,
  widths = [600, 1000],
  sizes = "(min-width: 768px) 768px, 100vw",
  class: className,
  priority,
} = Astro.props

const hasImage = project.image && project.imageAlt
---

{hasImage ? (
  <div class:list={["aspect-[4/3] overflow-hidden", className]}>
    <Picture
      src={project.image!}
      formats={["avif", "webp"]}
      widths={widths}
      sizes={sizes}
      alt={project.imageAlt ?? ""}
      priority={priority ? true : undefined}
      style={
        project.imageObjectPosition
          ? `object-position: ${project.imageObjectPosition}`
          : undefined
      }
      class="feather feather-sm h-full w-full object-cover"
    />
  </div>
) : (
  <div class:list={["aspect-[4/3] overflow-hidden", className]} />
)}
